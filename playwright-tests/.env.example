# Environment variables understood by the Playwright suites (src/config/env.ts, src/data/users.ts).
# Playwright does not read this file by itself: export the variables in your shell or define them as CI secrets.
#
# Leave BASE_URL and API_URL unset to test the bundled demo app: playwright.config.ts then starts
# the Task API (http://localhost:3000/api) and the Angular dev server (http://localhost:4200).

BASE_URL=http://localhost:4200
API_URL=http://localhost:3000/api

TEST_USER_EMAIL=demo@example.com
TEST_USER_PASSWORD=Demo123!
TEST_USER_NAME=Demo User

TEST_OTHER_USER_EMAIL=other@example.com
TEST_OTHER_USER_PASSWORD=Other123!
TEST_OTHER_USER_NAME=Other User
